{
  "expo": {
    "name": "BirdSong",
    "slug": "birdsong",
    "version": "0.1.0",
    "scheme": "birdsong",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.birdsong"
    },
    "android": {
      "package": "com.example.birdsong"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "BirdSong uses the microphone to record birdsong so it can identify the species you hear."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
